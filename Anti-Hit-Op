-- ============================================================
local NOT_EGG_NAMES = {
    bat = true, defaulttool = true, sword = true, knife = true,
    slap = true, coil = true, potion = true, lantern = true,
    tool = true, ["golden slap"] = true,
}

local function isToolEgg(t)
    if t:GetAttribute("IsEgg") == true then return true end
    if t:GetAttribute("Uid") ~= nil and t:GetAttribute("Uid") ~= "" then return true end
    if t:GetAttribute("AssetCategory") ~= nil then return true end
    local n = t.Name:lower()
    if n:find("egg") then return true end
    if not NOT_EGG_NAMES[n] and not n:find("bat") and not n:find("slap") then
        if t:FindFirstChild("Handle") then return true end
    end
    return false
end

local function isCarryingEgg()
    local char = LocalPlayer.Character
    if not char then return false end

    local flags = { "CarryingEgg", "HasEgg", "IsCarrying", "CarriedEgg" }
    for _, f in ipairs(flags) do
        if LocalPlayer:GetAttribute(f) == true then return true end
    end
    local uid = LocalPlayer:GetAttribute("CarriedUid")
    if uid and uid ~= "" then return true end

    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then
        local dropGui = pg:FindFirstChild("DropHeldEgg")
        if dropGui and dropGui.Enabled == true then return true end
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        if hrp:GetAttribute("CarryingEgg") == true then return true end
        if hrp:GetAttribute("HasEgg") == true then return true end
    end

    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and isToolEgg(t) then return true end
        if t:IsA("Model") then
            if t.Name:lower():find("egg") then return true end
            if t:GetAttribute("Uid") or t:GetAttribute("AssetCategory") then return true end
        end
        if t:IsA("Accessory") and t.Name:lower():find("egg") then return true end
    end

    return false
end

