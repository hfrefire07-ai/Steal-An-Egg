local dragging, dragStart, startPos = false, nil, nil
local targetPos  = FloatBtn.Position
local currentPos = FloatBtn.Position
local dragMoved  = false

local function lerpUDim(a, b, t)
    return UDim2.new(
        a.X.Scale  + (b.X.Scale  - a.X.Scale)  * t,
        a.X.Offset + (b.X.Offset - a.X.Offset) * t,
        a.Y.Scale  + (b.Y.Scale  - a.Y.Scale)  * t,
        a.Y.Offset + (b.Y.Offset - a.Y.Offset) * t
    )
end

FloatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging, dragStart, startPos, dragMoved = true, input.Position, targetPos, false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then dragMoved = true end
        targetPos = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X * 0.55,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y * 0.55
        )
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)
RunService.RenderStepped:Connect(function(dt)
    currentPos = lerpUDim(currentPos, targetPos, math.clamp(dt * 14, 0, 1))
    FloatBtn.Position = currentPos
end)

