task.spawn(function()
    local humConn = nil
    local baselineHP = 100

    local function bindHum(h)
        if humConn then pcall(function() humConn:Disconnect() end) end
        if not h then return end
        baselineHP = h.MaxHealth
        humConn = h:GetPropertyChangedSignal("Health"):Connect(function()
            if not antiHitEnabled then return end
            if not S.stealing then return end
            if h.Health < h.MaxHealth - 0.1 then
                pcall(function() h.Health = h.MaxHealth end)
                doEscape()
            end
        end)
    end

    LocalPlayer.CharacterAdded:Connect(function(c)
        task.wait(0.2)
        bindHum(c:FindFirstChildOfClass("Humanoid"))
    end)

    if LocalPlayer.Character then
        bindHum(LocalPlayer.Character:FindFirstChildOfClass("Humanoid"))
    end

    while true do
        if antiHitEnabled and S.stealing then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                if hum.Health < hum.MaxHealth - 0.1 then
                    pcall(function() hum.Health = hum.MaxHealth end)
                end
                local st = hum:GetState()
                if st == Enum.HumanoidStateType.Physics
                or st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown then
                    pcall(function() hum.PlatformStand = false end)
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
                if not humConn or baselineHP ~= hum.MaxHealth then
                    bindHum(hum)
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
end)

