-- ANTI-HIT — TOGGLE CON LÓGICA DEL STEAL
-- ============================================================
local antiHitEnabled = false

local ESCAPE_MAIN = {
    Vector3.new(500.62, 241.28, -366.64),
    Vector3.new(504.45, 155.8,  -366.35),
    Vector3.new(508.3,  70.28,  -366.03),
    Vector3.new(513.86, 70.28,  -366.25),
    Vector3.new(519.43, 70.28,  -366.47),
    Vector3.new(524.32, 70.28,  -366.59),
    Vector3.new(529.22, 70.28,  -366.71),
    Vector3.new(538.01, 70.28,  -365.55),
    Vector3.new(546.8,  70.28,  -364.4),
}
local SAFE_ANCHOR = Vector3.new(546.8, 70.28, -364.4)

local function doEscape()
    if not antiHitEnabled then return end
    local now = os.clock()
    if S.escaping then return end
    if (now - S.escapeAt) < ESCAPE_COOLDOWN then return end
    S.escaping = true
    S.escapeAt = now

    showFlash()

    task.spawn(function()
        local char = LocalPlayer.Character
        if not char then
            S.escaping = false
            hideFlash()
            return
        end
        pcall(function()
            for i, pos in ipairs(ESCAPE_MAIN) do
                local c = LocalPlayer.Character
                if not c then return end
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(pos)
                    hrp.AssemblyLinearVelocity  = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                else
                    pcall(function() c:PivotTo(CFrame.new(pos)) end)
                end
                if i < #ESCAPE_MAIN then RunService.Heartbeat:Wait() end
            end
            local c = LocalPlayer.Character
            if c then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(SAFE_ANCHOR)
                    hrp.AssemblyLinearVelocity  = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
        task.wait(0.05)
        S.escaping = false
        hideFlash()
    end)
end

