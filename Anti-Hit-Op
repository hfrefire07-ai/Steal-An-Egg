local function hideFlash()
    task.spawn(function()
        local t0 = os.clock()
        local dur = 0.2
        while os.clock() - t0 < dur do
            local a = (os.clock() - t0) / dur
            FlashFrame.BackgroundTransparency = a
            FlashText.TextTransparency        = a
            FlashText.TextStrokeTransparency  = a
