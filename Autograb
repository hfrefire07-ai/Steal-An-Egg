local KILL = {
    ParticleEmitter = true, Trail = true, Beam = true,
    Fire = true, Smoke = true, Sparkles = true, Explosion = true,
    Decal = true, Texture = true,
    Sky = true, Atmosphere = true, Cloud = true,
    Highlight = true, SelectionBox = true,
}

local function cleanObj(obj)
    if KILL[obj.ClassName] then
        pcall(function()
            local c = obj.ClassName
            if c == "Explosion" or c == "Cloud" then
                obj:Destroy()
            elseif c == "Decal" or c == "Texture" then
                obj.Transparency = 1
            elseif c == "Highlight" or c == "SelectionBox" then
                obj:Destroy()
            else
                obj.Enabled = false
            end
        end)
    end
end

Workspace.DescendantAdded:Connect(cleanObj)

task.spawn(function()
    local n = 0
    for _, o in ipairs(Workspace:GetDescendants()) do
        cleanObj(o)
        n = n + 1
        if n % 150 == 0 then task.wait() end
    end
end)

local function cleanCharacter(char)
    if not char then return end
    task.spawn(function()
        for _, p in ipairs(char:GetDescendants()) do
            pcall(function()
                if p:IsA("BasePart") then
                    p.Material = Enum.Material.SmoothPlastic
                    p.Reflectance = 0
                    p.CastShadow = false
                elseif p:IsA("Decal") or p:IsA("Texture") then
                    p.Transparency = 1
                elseif p:IsA("Accessory") then
                    p:Destroy()
                elseif p:IsA("ParticleEmitter") or p:IsA("Trail")
                or p:IsA("Beam") or p:IsA("Fire")
                or p:IsA("Smoke") or p:IsA("Sparkles") then
                    p.Enabled = false
                end
            end)
        end
    end)
end

local function hookPlr(plr)
    if plr.Character then cleanCharacter(plr.Character) end
    plr.CharacterAdded:Connect(cleanCharacter)
end
for _, p in ipairs(Players:GetPlayers()) do
