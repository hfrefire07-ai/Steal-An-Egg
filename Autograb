local HIDE_NAMES = {
    "PlayerList",
    "EmotesMenu",
    "EmoteMenu",
    "TopBarApp",
    "TopbarApp",
    "Notification",
    "NotificationFrame",
    "SettingsShade",
}

local function shouldHide(name)
    local lname = name:lower()
    for _, n in ipairs(HIDE_NAMES) do
        if lname == n:lower() then return true end
    end
    return false
end

local function hideGui(parent)
    if not parent then return end
    task.spawn(function()
        for _, g in ipairs(parent:GetChildren()) do
            pcall(function()
                if shouldHide(g.Name) then g.Enabled = false end
            end)
        end
    end)
end

hideGui(CoreGui)
hideGui(LocalPlayer:FindFirstChild("PlayerGui"))

local function watchGui(parent)
    if not parent then return end
    parent.ChildAdded:Connect(function(g)
        pcall(function()
            if shouldHide(g.Name) then g.Enabled = false end
        end)
    end)
end
