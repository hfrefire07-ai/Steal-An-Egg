local function getDeepGhostServer(threshold) 
    local currentId = tostring(game.JobId) 
    local cursor = "" 
    local candidates = {} 
    local maxPages = 200 
    local pageNum = 0 
    local overThreshold = false 

    -- Escanea hasta que encuentra servidores que superan tu límite
    while pageNum < maxPages and not overThreshold do 
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100" 
        if cursor ~= "" then url = url .. "&cursor=" .. cursor end 
        local ok, raw = pcall(function() return game:HttpGet(url) end) 
        if not ok or not raw or raw == "" then task.wait(0.3) break end 
        
        if raw:find("Too Many Requests") then 
            StatusLabel.Text = "Rate limit. Esperando 2s..." 
            task.wait(2) 
            continue 
        end 
        
        local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw) 
        if not ok2 or type(data) ~= "table" or not data.data then task.wait(0.2) break end 
        
        pageNum = pageNum + 1 
        
        for _, s in ipairs(data.data) do 
            local sid = tostring(s.id) 
            local playing = tonumber(s.playing) or 0 
            local maxP = tonumber(s.maxPlayers) or 0 
            
            if playing > threshold then 
                overThreshold = true 
                break 
            elseif playing > 0 and playing <= threshold and playing < maxP and sid ~= currentId then 
                table.insert(candidates, sid) 
            end 
        end 
        
        StatusLabel.Text = "Escanenado límite... Pág " .. pageNum .. " | Fantasmas: " .. #candidates 
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100) 
        
        if overThreshold or not data.nextPageCursor then break end 
        cursor = data.nextPageCursor 
    end 
    
    if #candidates == 0 then return nil end 
    
    local startIndex = math.max(1, #candidates - 30)
    local pickIndex = math.random(startIndex, #candidates)
    
    StatusLabel.Text = "Eligiendo del fondo extremo (Opción " .. pickIndex .. " de " .. #candidates .. ")" 
    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 150) 
    
    return candidates[pickIndex] 
end 

function hopOnce() 
    if isHopping then return false end 
    isHopping = true 
    local threshold = tonumber(MaxBox.Text) or 1 
    local currentCount = #Players:GetPlayers() 
    if currentCount <= threshold then 
        StatusLabel.Text = "Ya estás en un servidor perfecto (" .. currentCount .. " jug)." 
        StatusLabel.TextColor3 = Color3.fromRGB(150, 255, 150) 
        isHopping = false 
        return false 
    end 
    StatusLabel.Text = "Buscando servidor fantasma (" .. threshold .. " jug)..." 
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100) 
    
    local serverId = getDeepGhostServer(threshold) 
    
    if not serverId then 
        StatusLabel.Text = "Sin servidores fantasmas. Reintento..." 
        StatusLabel.TextColor3 = Color3.fromRGB(255, 120, 120) 
        isHopping = false 
        task.wait(3) 
        if autoEnabled then hopOnce() end 
        return false 
    end 
    
    StatusLabel.Text = "¡Servidor abisal hallado! Conectando..." 
    StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255) 
    local ok = pcall(function() 
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer) 
    end) 
    
    if not ok then 
        StatusLabel.Text = "Falló el teleport. Reintentando..." 
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100) 
        task.wait(2) 
        isHopping = false 
        hopOnce() 
        return false 
    end 
    return true 
end 

