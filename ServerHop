AutoBtn.MouseButton1Click:Connect(function() 
    ClickSound:Play() 
    autoEnabled = not autoEnabled 
    if autoEnabled then 
        AutoBtn.Text = "Auto Hop: ON" 
        AutoBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 70) 
        autoThread = task.spawn(function() 
            while autoEnabled and ScreenGui.Parent do 
                local threshold = tonumber(MaxBox.Text) or 1 
                local count = #Players:GetPlayers() 
                if count <= threshold then 
                    StatusLabel.Text = "✓ " .. count .. " jug aquí. Esperando..." 
                    StatusLabel.TextColor3 = Color3.fromRGB(150, 255, 150) 
                    task.wait(3) 
                else 
                    hopOnce() 
                    task.wait(5) 
                end 
            end 
        end) 
    else 
        AutoBtn.Text = "Auto Hop: OFF" 
        AutoBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60) 
        if autoThread then 
            task.cancel(autoThread) 
            autoThread = nil 
        end 
        StatusLabel.Text = "Auto Hop detenido." 
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 200) 
        isHopping = false 
    end 
end) 

